@page "/account"
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Account Settings - Green Squirrel Dev</PageTitle>

<div class="container account-container">
    <h1>Account Settings</h1>

    @if (isLoading)
    {
        <div class="loading">Loading account information...</div>
    }
    else if (user == null)
    {
        <div class="error">Unable to load account information. Please try again.</div>
    }
    else
    {
        <div class="account-card">
            <div class="account-header">
                @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                {
                    <img src="@user.ProfilePictureUrl" alt="@user.DisplayName" class="profile-picture" />
                }
                else
                {
                    <div class="profile-picture-placeholder">
                        @(user.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                    </div>
                }
                <div class="account-info">
                    <h2>@user.DisplayName</h2>
                    <p class="email">@user.Email</p>
                </div>
            </div>

            <div class="account-form">
                <h3>Edit Profile</h3>

                <div class="form-group">
                    <label for="displayName">Display Name</label>
                    <input type="text"
                           id="displayName"
                           @bind="editDisplayName"
                           @bind:event="oninput"
                           class="form-control"
                           placeholder="Enter your display name"
                           maxlength="100" />
                    <small class="form-hint">This name will be displayed across the site.</small>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-error">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                <div class="form-actions">
                    <button class="btn btn-primary"
                            @onclick="SaveChanges"
                            disabled="@(isSaving || !HasChanges)">
                        @if (isSaving)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                    <button class="btn btn-secondary"
                            @onclick="ResetChanges"
                            disabled="@(isSaving || !HasChanges)">
                        Cancel
                    </button>
                </div>
            </div>

            <div class="account-details">
                <h3>Account Information</h3>
                <div class="detail-row">
                    <span class="label">Email:</span>
                    <span class="value">@user.Email</span>
                </div>
                <div class="detail-row">
                    <span class="label">Account Created:</span>
                    <span class="value">@user.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="detail-row">
                    <span class="label">Last Login:</span>
                    <span class="value">@user.LastLoginAt.ToString("MMMM dd, yyyy HH:mm") UTC</span>
                </div>
            </div>

            <div class="kindle-settings">
                <h3>HiveReader - Kindle Settings</h3>
                <p class="section-description">
                    Configure your Kindle email address to receive articles via the HiveReader Chrome extension.
                </p>

                <div class="form-group">
                    <label for="kindleEmail">Kindle Email Address</label>
                    <input type="email"
                           id="kindleEmail"
                           @bind="editKindleEmail"
                           @bind:event="oninput"
                           class="form-control"
                           placeholder="yourname@kindle.com"
                           maxlength="100" />
                    <small class="form-hint">
                        Find your Kindle email in <a href="https://www.amazon.com/hz/mycd/myx#/home/settings/payment" target="_blank" rel="noopener">Amazon account settings</a> under "Send-to-Kindle E-Mail Settings".
                    </small>
                </div>

                @if (!string.IsNullOrEmpty(kindleErrorMessage))
                {
                    <div class="alert alert-error">@kindleErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(kindleSuccessMessage))
                {
                    <div class="alert alert-success">@kindleSuccessMessage</div>
                }

                <div class="form-actions">
                    <button class="btn btn-primary"
                            @onclick="SaveKindleEmail"
                            disabled="@(isSavingKindle || !HasKindleChanges)">
                        @if (isSavingKindle)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Kindle Email</span>
                        }
                    </button>
                    @if (!string.IsNullOrEmpty(originalKindleEmail))
                    {
                        <button class="btn btn-danger"
                                @onclick="RemoveKindleEmail"
                                disabled="@isSavingKindle">
                            Remove
                        </button>
                    }
                </div>

                <div class="kindle-instructions">
                    <h4>Setup Instructions</h4>
                    <ol>
                        <li>Find your Kindle email address in your Amazon account settings</li>
                        <li>Enter it above and save</li>
                        <li>Add <strong>noreply@greensquirrel.dev</strong> to your approved email list in Amazon's "Personal Document Settings"</li>
                        <li>Install the HiveReader Chrome extension</li>
                        <li>Click the extension on any article to send it to your Kindle</li>
                    </ol>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserProfileDTO? user;
    private string? editDisplayName;
    private string? originalDisplayName;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;
    private string? successMessage;

    // Kindle email fields
    private string? editKindleEmail;
    private string? originalKindleEmail;
    private bool isSavingKindle = false;
    private string? kindleErrorMessage;
    private string? kindleSuccessMessage;

    private bool HasChanges => editDisplayName != originalDisplayName && !string.IsNullOrWhiteSpace(editDisplayName);
    private bool HasKindleChanges => editKindleEmail != originalKindleEmail && !string.IsNullOrWhiteSpace(editKindleEmail);

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
        await LoadKindleEmail();
    }

    private async Task LoadUserProfile()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                editDisplayName = user.DisplayName;
                originalDisplayName = user.DisplayName;
            }
        }
        catch
        {
            errorMessage = "Failed to load account information.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadKindleEmail()
    {
        try
        {
            var kindleData = await AuthService.GetKindleEmailAsync();
            if (kindleData != null)
            {
                editKindleEmail = kindleData.KindleEmail;
                originalKindleEmail = kindleData.KindleEmail;
            }
        }
        catch
        {
            // Ignore errors loading Kindle email
        }
    }

    private async Task SaveChanges()
    {
        if (string.IsNullOrWhiteSpace(editDisplayName))
        {
            errorMessage = "Display name cannot be empty.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var updatedUser = await AuthService.UpdateProfileAsync(editDisplayName.Trim());
            if (updatedUser != null)
            {
                user = updatedUser;
                originalDisplayName = updatedUser.DisplayName;
                editDisplayName = updatedUser.DisplayName;
                successMessage = "Your profile has been updated successfully.";

                // Clear cache to refresh the layout
                AuthService.ClearCache();
            }
            else
            {
                errorMessage = "Failed to update profile. Please try again.";
            }
        }
        catch
        {
            errorMessage = "An error occurred while saving changes.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetChanges()
    {
        editDisplayName = originalDisplayName;
        errorMessage = null;
        successMessage = null;
    }

    private async Task SaveKindleEmail()
    {
        if (string.IsNullOrWhiteSpace(editKindleEmail))
        {
            kindleErrorMessage = "Kindle email address is required.";
            return;
        }

        if (!editKindleEmail.Trim().EndsWith("@kindle.com", StringComparison.OrdinalIgnoreCase))
        {
            kindleErrorMessage = "Please enter a valid @kindle.com email address.";
            return;
        }

        isSavingKindle = true;
        kindleErrorMessage = null;
        kindleSuccessMessage = null;

        try
        {
            var result = await AuthService.UpdateKindleEmailAsync(editKindleEmail.Trim());
            if (result != null)
            {
                originalKindleEmail = result.KindleEmail;
                editKindleEmail = result.KindleEmail;
                kindleSuccessMessage = "Your Kindle email has been saved. Don't forget to whitelist noreply@greensquirrel.dev in your Amazon account!";
            }
            else
            {
                kindleErrorMessage = "Failed to save Kindle email. Please try again.";
            }
        }
        catch
        {
            kindleErrorMessage = "An error occurred while saving.";
        }
        finally
        {
            isSavingKindle = false;
        }
    }

    private async Task RemoveKindleEmail()
    {
        isSavingKindle = true;
        kindleErrorMessage = null;
        kindleSuccessMessage = null;

        try
        {
            var success = await AuthService.DeleteKindleEmailAsync();
            if (success)
            {
                originalKindleEmail = null;
                editKindleEmail = null;
                kindleSuccessMessage = "Your Kindle email has been removed.";
            }
            else
            {
                kindleErrorMessage = "Failed to remove Kindle email. Please try again.";
            }
        }
        catch
        {
            kindleErrorMessage = "An error occurred while removing.";
        }
        finally
        {
            isSavingKindle = false;
        }
    }
}
