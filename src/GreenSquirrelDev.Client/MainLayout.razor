@inherits LayoutComponentBase

<div class="page">
    <header class="header">
        <div class="container">
            <nav class="nav">
                <div class="nav-brand">
                    <a href="/" class="logo">
                        <img src="/images/logo.svg" alt="Green Squirrel Dev" />
                        <span>Green Squirrel Dev</span>
                    </a>
                </div>
                <div class="nav-menu">
                    <a href="/" class="nav-link">Home</a>
                    <a href="/#projects" class="nav-link">Projects</a>
                    <a href="/#about" class="nav-link">About</a>
                    <AuthorizeView>
                        <Authorized>
                            <a href="/profile" class="nav-link">Profile</a>
                            <a href="/logout" class="btn btn-secondary">Sign Out</a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn btn-primary">Sign In with Google</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <Footer />
</div>

