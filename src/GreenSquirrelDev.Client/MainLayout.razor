@inherits LayoutComponentBase
@inject IAuthService AuthService

<div class="page">
    <header class="header">
        <div class="container">
            <nav class="nav">
                <div class="nav-brand">
                    <a href="/" class="logo">
                        <img src="/images/logo.svg" alt="Green Squirrel Dev" />
                        <span>Green Squirrel Dev</span>
                    </a>
                </div>
                <div class="nav-menu">
                    <a href="/" class="nav-link">Home</a>
                    <a href="/#projects" class="nav-link">Projects</a>
                    <a href="/#about" class="nav-link">About</a>
                    <AuthorizeView>
                        <Authorized>
                            <a href="/account" class="nav-link user-link">
                                @if (!string.IsNullOrEmpty(userDisplayName))
                                {
                                    <span>@userDisplayName</span>
                                }
                                else
                                {
                                    <span>Account</span>
                                }
                            </a>
                            <a href="/.auth/logout?post_logout_redirect_uri=/" class="btn btn-secondary">Sign Out</a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/.auth/login/google?post_login_redirect_uri=/login-callback" class="btn btn-primary">Sign In with Google</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <Footer />
</div>

@code {
    private string? userDisplayName;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null)
        {
            userDisplayName = user.DisplayName;
        }
    }
}
