<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">
                    Crafted tools by<br /><span class="brand-highlight">Green Squirrel Dev</span>
                </h1>
                <p class="hero-subtitle">
                    Thoughtfully built applications for runners, readers, and productivity enthusiasts.
                    One acorn at a time.
                </p>
                <div class="hero-actions">
                    <AuthorizeView>
                        <Authorized>
                            <a href="#projects" class="btn btn-primary btn-large">Explore Projects</a>
                            <a href="/profile" class="btn btn-secondary btn-large">My Profile</a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="#projects" class="btn btn-primary btn-large">Explore Projects</a>
                            <a href="/.auth/login/google?post_login_redirect_uri=/login-callback" class="btn btn-secondary btn-large">Get Started</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
            <div class="hero-image">
                <img src="/images/squirrel-logo.png" alt="Green Squirrel logo" class="squirrel-mascot" />
            </div>
        </div>
    </div>
</section>

